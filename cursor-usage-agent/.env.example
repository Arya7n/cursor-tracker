# Copy to .env next to docker-compose.yml on the VM
ENROLLMENT_SECRET=generate-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=generate-another-long-random-string
ADMIN_ROUTE_SECRET=pick-a-long-random-slug
# Local Docker Postgres (compose). On Vercel, use a Neon connection string instead.
DATABASE_URL=postgres://cursor:cursor@127.0.0.1:5432/cursor_usage
