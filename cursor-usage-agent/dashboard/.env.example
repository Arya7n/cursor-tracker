# Shared secret used by developer PCs to enroll (change this)
ENROLLMENT_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin
# Optional but recommended — keeps Edge middleware + API session signing in sync
# SESSION_SECRET=generate-a-long-random-string
# Local Docker: postgres://cursor:cursor@127.0.0.1:5432/cursor_usage
# Neon / Vercel: pooled connection string from the Neon console
DATABASE_URL=postgres://cursor:cursor@127.0.0.1:5432/cursor_usage
# Set false only for local Docker. Omit for Neon (TLS is required).
DATABASE_SSL=false
# Desktop installer URLs (GitHub Release assets recommended on Vercel)
# WINDOWS_DOWNLOAD_URL=https://github.com/ORG/REPO/releases/download/desktop-v0.1.1/CursorUsageSetup-latest.exe
# LINUX_DOWNLOAD_URL=https://github.com/ORG/REPO/releases/download/desktop-v0.1.1/CursorUsage-latest.AppImage
