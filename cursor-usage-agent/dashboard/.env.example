# Shared secret used by developer PCs to enroll (change this)
ENROLLMENT_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin
# Local Docker: postgres://cursor:cursor@127.0.0.1:5432/cursor_usage
# Neon / Vercel: pooled connection string from the Neon console
DATABASE_URL=postgres://cursor:cursor@127.0.0.1:5432/cursor_usage
# Set false only for local Docker. Omit for Neon (TLS is required).
DATABASE_SSL=false
# Windows desktop installer URL (use a .zip on GitHub Releases — .exe uploads are often blocked)
# WINDOWS_DOWNLOAD_URL=https://github.com/ORG/REPO/releases/download/desktop-v0.1.1/CursorUsageSetup-0.1.1-win-x64.zip
